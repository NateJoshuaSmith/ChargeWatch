# Port the API listens on. Defaults to 3000 when unset.
PORT=3000

# Postgres role created for the local database. Docker Compose reads this from .env.
POSTGRES_USER=your_user

# Password for that local Postgres role. Docker Compose reads this from .env.
POSTGRES_PASSWORD=your_password

# Local database name. Docker Compose reads this from .env.
POSTGRES_DB=your_database

# Local value points at Docker. In production, set the host's Postgres connection string in the dashboard, never in a file.
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_database

# Frankfurter API origin. Defaults to https://api.frankfurter.dev when unset.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# Secret used to sign login tokens. Required, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
