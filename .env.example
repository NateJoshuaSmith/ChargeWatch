# Port the API listens on. Defaults to 3000 when unset.
PORT=3000

# Postgres role created for the local database. Docker Compose reads this from .env.
POSTGRES_USER=your_user

# Password for that local Postgres role. Docker Compose reads this from .env.
POSTGRES_PASSWORD=your_password

# Local database name. Docker Compose reads this from .env.
POSTGRES_DB=your_database

# Postgres connection string for the app and Prisma. Host is localhost and port is 5432.
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_database
